# Xochipilli — video provider settings
# ショチピリ — 映像生成プロバイダ設定
# Xochipilli — 影像生成提供方设置
#
# EN: cp .env.example .env  → edit values → ./RUN_ME.sh
# JA: cp .env.example .env  → 値を書いてから ./RUN_ME.sh
# ZH: cp .env.example .env  → 填写后 ./RUN_ME.sh
#
# mock = local placeholder video (default, no API)
#        ローカル仮映像（既定・API不要） / 本地占位影像（默认、无需 API）
# fal  = FAL.ai (needs FAL_KEY) / FAL.ai（要 FAL_KEY）
# xai  = Grok Imagine video (needs XAI_API_KEY, or an existing OAuth session)
#        Grok Imagine 映像（XAI_API_KEY、または既存の OAuth セッション）
#        alias / 別名 / 别名: grok
VIDEO_PROVIDER=mock

# --- Generation unit (auto-split) ---
# Longer segments are split into sequential clips of this length,
# chained via last-frame I2V, then concatenated.
# 長い区間はこの秒数で自動分割 → 最終フレーム連鎖 → 連結
# CLIP_UNIT_SECONDS=5

# --- FAL ---
# FAL_KEY=
# FAL_VIDEO_MODEL=fal-ai/minimax-video
# Examples / 例:
#   fal-ai/minimax-video
#   fal-ai/kling-video/v2.1/standard/image-to-video
#   (check fal.ai model gallery for current IDs)

# --- xAI / Grok Imagine ---
# EN: Bring your own key.
# JA: 自分のキーを使う。
# ZH: 使用自己的密钥。
# XAI_API_KEY=
#
# Optional, opt-in: reuse an OAuth session you already have instead of a key.
# Leave both unset and only XAI_API_KEY is used.
# XAI_OAUTH_HELPER=   # directory exposing tools/xai_http.py (refresh-aware)
# XAI_TOKEN_STORE=    # JSON file holding an OAuth access token
#
# Models (override as needed):
# XAI_VIDEO_MODEL=grok-imagine-video
# XAI_VIDEO_I2V_MODEL=grok-imagine-video-1.5
#   T2V = text-to-video (no start frame)
#   I2V = image-to-video (chain / ref image)
#
# Resolution: 480p | 720p | 1080p  (default 720p)
# 解像度: 480p / 720p / 1080p（既定 720p）
# XAI_VIDEO_RESOLUTION=720p
# XAI_VIDEO_RESOLUTION=1080p
#
# Aspect: 16:9 | 9:16 | 1:1 | …
# XAI_VIDEO_ASPECT=16:9
#
# XAI_VIDEO_TIMEOUT=240
# XAI_VIDEO_POLL=5

# --- Canva Connect (export polish / 仕上げ) ---
# Create integration: https://www.canva.com/developers/integrations
# Redirect URL must match:
#   http://127.0.0.1:8787/api/canva/callback
# Scopes: asset:read asset:write design:content:write design:meta:read profile:read
# CANVA_CLIENT_ID=
# CANVA_CLIENT_SECRET=
# CANVA_REDIRECT_URI=http://127.0.0.1:8787/api/canva/callback
# CANVA_SCOPES=asset:read asset:write design:content:write design:meta:read profile:read
